# Application Settings
APP_NAME="Rehnuma"
APP_VERSION="1.0.0"
DEBUG=false

# Database (Neon PostgreSQL)
# Get your connection string from https://neon.tech
DATABASE_URL="postgresql://user:password@localhost:5432/admission_db"

# Embedding Model — Google gemini-embedding-001 (768-dim). Drives both
# ingestion and the semantic retrieval arm. GEMINI_API_KEY is required.
# If you change these, run `alembic upgrade head` then
# `python scripts/reembed_chunks.py` to rebuild the vectors.
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSION=768

# LLM Provider Keys — GEMINI_API_KEY is required (embeddings + answer
# generation). OPENAI_API_KEY is optional: set it only to keep OpenAI as a
# generation fallback.
# Get Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional generation fallback. Get a key from https://platform.openai.com
OPENAI_API_KEY=""

# LLM Settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
# Google rotates model ids often; set this to whatever is current.
GEMINI_MODEL="gemini-3.6-flash"
# Only used when OPENAI_API_KEY is set.
OPENAI_MODEL="gpt-4o"

# Retrieval Settings
RETRIEVAL_TOP_K=20
RRF_K=60
RRF_WEIGHT_KEYWORD=0.5
RRF_WEIGHT_SEMANTIC=0.5

# Redis (for response caching and rate limiting).
# Leave blank to disable caching (rate limiting then uses in-process memory).
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=86400

# Rate Limiting (requests per client IP)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# Auth
# SECRET_KEY signs JWTs. Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with this placeholder unless DEBUG=true.
SECRET_KEY="change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_REGISTRATION_KEY="your-strong-admin-key"

# Monitoring (Sentry)
# Get DSN from https://sentry.io
SENTRY_DSN=""

# CORS Origins (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
