# Application Settings
APP_NAME="Admission Policy Chatbot"
APP_VERSION="1.0.0"
DEBUG=false

# Database (Neon PostgreSQL)
# Get your connection string from https://neon.tech
DATABASE_URL="postgresql://user:password@localhost:5432/admission_db"

# Embedding Model — uses Gemini (gemini-embedding-001, 768-dim) whenever GEMINI_API_KEY
# is set; EMBEDDING_MODEL/EMBEDDING_DIMENSION below only apply to the OpenAI fallback path.
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# LLM Provider Keys
# Get OpenAI API key from https://platform.openai.com
OPENAI_API_KEY=""

# Get Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# LLM Settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Retrieval Settings
RETRIEVAL_TOP_K=20
RRF_K=60
RRF_WEIGHT_KEYWORD=0.5
RRF_WEIGHT_SEMANTIC=0.5

# Redis (for caching and rate limiting)
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=86400

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# Auth
SECRET_KEY="change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_REGISTRATION_KEY="your-strong-admin-key"

# Monitoring (Sentry)
# Get DSN from https://sentry.io
SENTRY_DSN=""

# CORS Origins (comma-separated for multiple)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
